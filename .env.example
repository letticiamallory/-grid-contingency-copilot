# Copie para .env e preencha. Nunca versione o .env.
DATABASE_URL=postgresql://copilot:copilot@localhost:5432/copilot
MIGRATIONS_DIR=migrations

# Necessaria para embeddings (make ingest) e para modelos reais.
OPENROUTER_API_KEY=

# Dimensao fixa no schema (vector(1536)); trocar o modelo exige nova migration e reindexacao.
EMBEDDING_MODEL=openai/text-embedding-3-small

# Modelo de geracao (identificador OpenRouter). Vazio = API responde 503 llm_unavailable.
LLM_MODEL=anthropic/claude-haiku-5.5
# Opcional: modelo secundario usado se o primario falhar (nao usar na avaliacao).
LLM_FALLBACK_MODEL=
